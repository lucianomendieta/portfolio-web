---
import { servicios } from '../data/servicios';
import { reservaHref } from '../data/site';

/**
 * Servicios como carta de barbería: grupo, ítem, línea de puntos y precio
 * a la derecha. Los precios salen de src/data/servicios.ts (hoy null ->
 * placeholder "A consultar").
 */
---
<section class="section servicios" id="servicios" aria-labelledby="servicios-title">
  <div class="container">
    <div class="menu-card">
      <header class="servicios__head">
        <p class="eyebrow">Servicios</p>
        <h2 id="servicios-title" class="section-title">La carta</h2>
        <p class="lead">
          Corte, barba y detalle. Elegí lo tuyo y reservá el turno por WhatsApp.
        </p>
      </header>

      {servicios.map((grupo) => (
        <div class="menu-group">
          <h3 class="menu-group__title">
            {grupo.nombre}
            {grupo.nota && <span class="menu-group__tag">{grupo.nota}</span>}
          </h3>

          <ul class="menu-group__items" role="list">
            {grupo.items.map((item) => (
              <li class="menu-item">
                <span class="menu-item__name">{item.nombre}</span>
                <span class="menu-item__leader" aria-hidden="true"></span>
                <span class="menu-item__price">
                  {item.precioDesde ?? 'A consultar'}
                </span>
                {item.descripcion && (
                  <span class="menu-item__desc">{item.descripcion}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="servicios__cta">
        <p class="servicios__cta-text">
          ¿No tenés ni idea qué pedir? Contanos y te tiramos la posta.
        </p>
        <a class="btn" href={reservaHref} target="_blank" rel="noopener">
          Reservar turno
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .menu-card {
    max-width: var(--container-narrow);
    margin-inline: auto;
    padding: clamp(1.5rem, 5vw, 3rem);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }

  .servicios__head { margin-bottom: var(--space-5); }

  .menu-group { margin-bottom: var(--space-4); }
  .menu-group:last-of-type { margin-bottom: var(--space-5); }

  .menu-group__title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--fs-h3);
    padding-bottom: 0.6rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-line);
  }

  .menu-group__tag {
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    background: var(--color-primary);
    padding: 0.25rem 0.55rem;
  }

  .menu-group__items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-item {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.6rem 0;
  }
  .menu-item__name {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--color-ink);
  }
  .menu-item__leader {
    flex: 1;
    border-bottom: 2px dotted var(--color-line);
    height: 1px;
    transform: translateY(-0.35em);
  }
  .menu-item__price {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .menu-item__desc {
    display: block;
    width: 100%;
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
    margin-top: 0.2rem;
    order: 99;
  }

  .servicios__cta {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .servicios__cta-text { color: var(--color-ink-soft); max-width: 40ch; }

  @media (min-width: 620px) {
    .servicios__cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (max-width: 420px) {
    .menu-item__name { white-space: normal; }
  }
</style>
