---
/**
 * Íconos de línea de servicio (SVG inline, decorativos, currentColor).
 * Trazo a tono con el acento. aria-hidden: el nombre de la línea ya da el contexto.
 */
interface Props { name: 'corte' | 'barba' | 'combo' | 'perfilado'; }
const { name } = Astro.props;
---
<svg class="servicio-icon" viewBox="0 0 32 32" fill="none"
     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
  {name === 'corte' && (
    <g>
      {/* Tijera */}
      <circle cx="8" cy="22" r="3.2" />
      <circle cx="8" cy="10" r="3.2" />
      <path d="M10.5 12 L26 24" />
      <path d="M10.5 20 L26 8" />
    </g>
  )}
  {name === 'barba' && (
    <g>
      {/* Bigote / barba */}
      <path d="M16 14 C 12 14, 10 18, 6 18 C 8.5 20.5, 13 19, 16 16.5 C 19 19, 23.5 20.5, 26 18 C 22 18, 20 14, 16 14 Z" />
      <path d="M16 8 v4" />
    </g>
  )}
  {name === 'combo' && (
    <g>
      {/* Navaja recta */}
      <path d="M6 22 L20 8 a2.6 2.6 0 0 1 3.6 3.6 L11 24" />
      <path d="M20.5 20.5 l6 6" />
      <path d="M8 24 a2.8 2.8 0 0 1-4-4" />
    </g>
  )}
  {name === 'perfilado' && (
    <g>
      {/* Máquina / trimmer */}
      <rect x="7" y="12" width="18" height="7" rx="1.5" />
      <path d="M8 19 v3 M11.5 19 v3 M15 19 v3 M18.5 19 v3 M22 19 v3" />
      <path d="M25 14 h3" />
    </g>
  )}
</svg>
