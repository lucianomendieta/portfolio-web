---
/**
 * Divisor decorativo con un bigote estilizado (identidad de El Roble).
 * Reutilizable entre secciones. Es puramente ornamental -> aria-hidden.
 *
 * Props:
 *  - tone: 'ink' | 'light'. Ajusta la intensidad de las líneas. Default 'ink'.
 */
interface Props {
  tone?: 'ink' | 'light';
  class?: string;
}
const { tone = 'ink', class: className = '' } = Astro.props;
---

<div class:list={['loto-divider', { 'is-light': tone === 'light' }, className]} aria-hidden="true">
  <span class="loto-divider__rule"></span>
  <svg class="loto-divider__mark" viewBox="0 0 64 32" width="64" height="32" role="presentation" focusable="false">
    <!-- Bigote estilizado -->
    <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M32 12 C 26 12, 22 20, 14 20 C 8 20, 6 15, 6 12 C 8 15, 12 16, 16 15 C 22 13.5, 27 13, 32 16" />
      <path d="M32 12 C 38 12, 42 20, 50 20 C 56 20, 58 15, 58 12 C 56 15, 52 16, 48 15 C 42 13.5, 37 13, 32 16" />
    </g>
  </svg>
  <span class="loto-divider__rule"></span>
</div>

<style>
  .loto-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    color: var(--color-primary);
    margin-block: var(--space-5);
  }
  .loto-divider__rule {
    height: 1px;
    width: min(120px, 20vw);
    background: linear-gradient(
      to var(--_dir, right),
      transparent,
      color-mix(in srgb, var(--color-primary) 55%, transparent)
    );
  }
  .loto-divider__rule:last-child { --_dir: left; }
  .loto-divider__mark { flex: none; opacity: 0.9; }

  /* En secciones oscuras el acento igual funciona, pero suavizamos las líneas */
  .loto-divider.is-light .loto-divider__rule {
    background: linear-gradient(
      to var(--_dir, right),
      transparent,
      color-mix(in srgb, var(--color-primary) 70%, transparent)
    );
  }
</style>
