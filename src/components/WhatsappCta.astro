---
// Botón CTA rojo hacia WhatsApp. Reutilizado por Hero y CtaFinal.
// El número real se define una sola vez en src/config.ts (ver TODO ahí).
import { WHATSAPP_URL } from '../config';

interface Props {
  size?: 'md' | 'lg';
}
const { size = 'md' } = Astro.props;
---

<a
  href={WHATSAPP_URL}
  class:list={['cta', size]}
  target="_blank"
  rel="noopener noreferrer"
>
  Escribime por WhatsApp <span class="arrow" aria-hidden="true">→</span>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-accent);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    border-radius: 8px;
    line-height: 1.1;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }

  .cta.md {
    font-size: 16px;
    padding: 15px 26px; /* ~48px de alto ≥ 44px objetivo táctil */
  }
  .cta.lg {
    font-size: 17px;
    padding: 16px 30px;
  }

  .cta:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
    color: #fff;
  }

  .arrow {
    font-family: var(--font-mono);
    font-size: 13px;
    opacity: 0.8;
  }
  .cta.lg .arrow {
    font-size: 14px;
  }
</style>
