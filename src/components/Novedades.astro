---
import { novedades } from '../data/novedades';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const items = limit ? novedades.slice(0, limit) : novedades;

const tagLabel: Record<string, string> = {
  cliente: 'cliente',
  producto: 'producto',
  novedad: 'novedad',
};
---

<section id="novedades" class="novedades">
  <div class="wrap">
    <div class="head">
      <span class="kicker">Novedades</span>
      <h2 class="title">Lo más reciente</h2>
    </div>

    <ol class="feed">
      {items.map((n) => (
        <li class="entrada" data-reveal>
          <div class="meta">
            <time class="fecha">{n.fecha}</time>
            <span class={`tag tag--${n.tag}`}>{tagLabel[n.tag]}</span>
          </div>
          <div class="contenido">
            <h3 class="entrada-titulo">{n.titulo}</h3>
            <p class="entrada-cuerpo">{n.cuerpo}</p>
            {n.link && (
              <a class="entrada-link" href={n.link.href} target="_blank" rel="noopener noreferrer">
                {n.link.label} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .novedades {
    background: var(--color-bg);
    color: var(--color-ink);
    padding: var(--pad-y) 0;
  }
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 var(--pad-x);
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 5vw, 48px);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--color-cyan);
    text-transform: uppercase;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  /* Feed */
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .entrada {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: clamp(16px, 3vw, 32px);
    padding: clamp(20px, 3vw, 28px) 0;
    border-top: 1px solid var(--color-border);
  }
  .feed li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  /* Columna izquierda: fecha + tag */
  .meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 3px;
  }
  .fecha {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--color-ink-faint);
  }
  .tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid;
  }
  .tag--cliente {
    color: var(--color-cyan);
    border-color: rgb(34 211 238 / 0.35);
    background: rgb(34 211 238 / 0.07);
  }
  .tag--producto {
    color: var(--color-link);
    border-color: rgb(129 140 248 / 0.35);
    background: rgb(129 140 248 / 0.07);
  }
  .tag--novedad {
    color: var(--color-ink-soft);
    border-color: var(--color-border-strong);
    background: transparent;
  }

  /* Columna derecha: contenido */
  .contenido {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .entrada-titulo {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.3;
    color: var(--color-ink);
  }
  .entrada-cuerpo {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 58ch;
  }
  .entrada-link {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-link);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .entrada-link:hover {
    color: var(--color-cyan);
  }

  @media (max-width: 600px) {
    .entrada {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .meta {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
