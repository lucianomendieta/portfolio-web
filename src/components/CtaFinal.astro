---
import WhatsappCta from './WhatsappCta.astro';
import Footer from './Footer.astro';
import { LINKEDIN_URL } from '../config';
---

<section id="contacto" class="cta-final">
  <div class="wrap">
    <span class="kicker">Hablemos</span>
    <h2 class="title">Contame de tu negocio y armamos tu web.</h2>
    <p class="lede">
      Un mensaje directo por WhatsApp y en el día te digo cómo lo encaramos. Sin
      compromiso.
    </p>
    <div class="actions">
      <WhatsappCta size="lg" />
      <a href={LINKEDIN_URL} class="ver-link" target="_blank" rel="noopener noreferrer">
        Ver LinkedIn
      </a>
    </div>

    <Footer />
  </div>
</section>

<style>
  .cta-final {
    background: var(--color-bg);
    color: var(--color-ink);
    padding: clamp(56px, 11vw, 112px) 0;
  }
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.6vw, 12px);
    letter-spacing: 0.1em;
    color: var(--color-cyan);
    text-transform: uppercase;
  }
  .title {
    margin: 18px 0 24px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h2-cta);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
    max-width: 16ch;
  }
  .lede {
    margin: 0 0 32px;
    font-size: clamp(16px, 3.4vw, 19px);
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 48ch;
  }
  .actions {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
  }
  .ver-link {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: 2px;
  }
  .ver-link:hover {
    color: var(--color-ink);
  }
</style>
