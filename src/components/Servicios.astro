---
const servicios = [
  {
    n: '01',
    title: 'Landing pages',
    desc: 'Una página bien hecha que cuenta qué hacés, muestra tu trabajo y lleva a que te escriban.',
    tag: 'diseño + código',
  },
  {
    n: '02',
    title: 'Mantenimiento mensual',
    desc: 'Cambios de fotos, precios y textos cuando los necesites. Vos me avisás, yo lo actualizo.',
    tag: 'al día',
  },
  {
    n: '03',
    title: 'Dominio y hosting',
    desc: 'Me encargo de la parte técnica: tu dirección web propia y que el sitio esté siempre online.',
    tag: 'sin vueltas',
  },
];
---

<section class="servicios">
  <div class="head">
    <span class="eyebrow">04 — servicios</span>
    <h2 class="title">Lo que hago por vos</h2>
  </div>

  <div class="menu">
    {
      servicios.map((s) => (
        <div class="row" data-reveal>
          <span class="num">{s.n}</span>
          <div class="row-body">
            <div class="row-text">
              <h3 class="row-title">{s.title}</h3>
              <p class="row-desc">{s.desc}</p>
            </div>
            <span class="row-tag">{s.tag}</span>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .servicios {
    background: var(--color-tinta);
    color: var(--color-papel);
    padding: var(--pad-y) var(--pad-x);
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: clamp(28px, 5vw, 52px);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--color-bronce);
    text-transform: uppercase;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--color-papel);
  }

  .menu {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    max-width: 900px;
    border-top: 1px solid rgb(241 237 225 / 0.16);
  }

  .row {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: clamp(16px, 3vw, 28px);
    align-items: start;
    padding: clamp(22px, 4vw, 32px) 0;
    border-bottom: 1px solid rgb(241 237 225 / 0.16);
  }
  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-bronce);
    padding-top: 6px;
  }

  .row-body {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .row-text {
    max-width: 44ch;
  }
  .row-title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 4vw, 27px);
    color: var(--color-papel);
  }
  .row-desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: rgb(241 237 225 / 0.68);
  }
  .row-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgb(156 122 52 / 0.9);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
</style>
