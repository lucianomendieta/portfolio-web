---
const servicios = [
  {
    n: '01',
    title: 'Landing pages',
    desc: 'Una página bien hecha que cuenta qué hacés, muestra tu trabajo y lleva a que te escriban.',
    tag: 'diseño + código',
  },
  {
    n: '02',
    title: 'Mantenimiento mensual',
    desc: 'Cambios de fotos, precios y textos cuando los necesites. Vos me avisás, yo lo actualizo.',
    tag: 'al día',
  },
  {
    n: '03',
    title: 'Dominio y hosting',
    desc: 'Me encargo de la parte técnica: tu dirección propia y que el sitio esté siempre online.',
    tag: 'sin vueltas',
  },
];
---

<section class="servicios">
  <div class="wrap">
    <div class="head">
      <span class="kicker">Servicios</span>
      <h2 class="title">Lo que hago por vos</h2>
    </div>

    <div class="menu">
      {
        servicios.map((s) => (
          <div class="row" data-reveal>
            <span class="num">{s.n}</span>
            <div class="row-body">
              <div class="row-text">
                <h3 class="row-title">{s.title}</h3>
                <p class="row-desc">{s.desc}</p>
              </div>
              <span class="row-tag">{s.tag}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .servicios {
    background: var(--color-bg);
    color: var(--color-ink);
    padding: var(--pad-y) 0;
  }
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--color-cyan);
    text-transform: uppercase;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  .menu {
    display: flex;
    flex-direction: column;
    max-width: 900px;
    border-top: 1px solid var(--color-border);
  }

  .row {
    display: flex;
    gap: clamp(16px, 3vw, 20px);
    align-items: flex-start;
    padding: clamp(22px, 4vw, 30px) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-cyan);
    padding-top: 4px;
    flex: none;
    width: 28px;
  }

  .row-body {
    flex: 1;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .row-text {
    max-width: 44ch;
  }
  .row-title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 4vw, 22px);
    color: var(--color-ink);
  }
  .row-desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
  .row-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-cyan);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .row-body {
      flex-direction: column;
    }
  }
</style>
