---
import WhatsappCta from './WhatsappCta.astro';
---

<section class="hero">
  <!-- barra superior: wordmark + coordenada -->
  <div class="topbar">
    <span class="wordmark">Luchii</span>
    <span class="coord">25.29°S · 57.63°W</span>
  </div>

  <div class="stack">
    <span class="eyebrow">Asunción, PY — dev independiente</span>
    <h1 class="title">
      Webs para negocios que la gente encuentra, no solo que tienen.
    </h1>
    <p class="lede">
      Hago sitios rápidos y claros para salones, barberías y comercios de barrio.
      Vos me contás qué hacés; yo lo pongo online para que te encuentren y te
      escriban.
    </p>
    <div class="actions">
      <WhatsappCta size="md" />
      <a href="#muestras" class="ver-muestras">ver muestras</a>
    </div>
  </div>

  <!-- anotación de margen -->
  <div class="annotation" aria-hidden="true">
    <div class="rule"></div>
    — 01 hero · 1440px<br />carga &lt; 1s
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-tinta);
    color: var(--color-papel);
    padding: clamp(28px, 6vw, 64px) var(--pad-x) clamp(48px, 9vw, 110px);
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: clamp(56px, 12vw, 140px);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .coord {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-bronce);
    text-transform: uppercase;
  }

  .stack {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 5vw, 44px);
    max-width: 1180px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.6vw, 13px);
    letter-spacing: 0.12em;
    color: var(--color-bronce);
    text-transform: uppercase;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h1);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-papel);
    text-wrap: balance;
    max-width: 14ch;
  }
  .lede {
    margin: 0;
    font-size: var(--text-body);
    line-height: 1.55;
    color: rgb(241 237 225 / 0.72);
    max-width: 52ch;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: clamp(16px, 4vw, 28px);
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .ver-muestras {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: rgb(241 237 225 / 0.7);
    border-bottom: 1px solid rgb(156 122 52 / 0.5);
    padding-bottom: 2px;
  }
  .ver-muestras:hover {
    color: var(--color-papel);
  }

  .annotation {
    position: absolute;
    right: clamp(16px, 5vw, 48px);
    bottom: clamp(20px, 5vw, 40px);
    text-align: right;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.7;
    color: rgb(156 122 52 / 0.85);
    letter-spacing: 0.03em;
  }
  .annotation .rule {
    width: 46px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-bronce));
    margin-left: auto;
    margin-bottom: 8px;
  }

  /* La anotación de margen se solaparía con el contenido en pantallas
     angostas: la ocultamos en mobile (es decorativa). */
  @media (max-width: 640px) {
    .annotation {
      display: none;
    }
  }
</style>
