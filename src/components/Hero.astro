---
import WhatsappCta from './WhatsappCta.astro';
import { LINKEDIN_URL, KUARAHY_URL } from '../config';
---

<header class="hero">
  <div class="wrap">
    <!-- barra superior: nombre + LinkedIn -->
    <div class="topbar">
      <span class="wordmark">Luciano Mendieta</span>
      <a href={LINKEDIN_URL} class="li-link" target="_blank" rel="noopener noreferrer">
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="stack">
      <span class="kicker">Desarrollador web · Asunción, PY</span>
      <h1 class="title">
        Una web clara, para que a tu negocio lo encuentren y te escriban.
      </h1>
      <p class="lede">
        Armo sitios rápidos y simples para negocios locales. Vos me contás cómo es
        tu negocio; yo lo pongo online, fácil de entender y fácil de encontrar.
      </p>
      <p class="kuarahy-mention">
        Además, soy cofundador de <a href={KUARAHY_URL} target="_blank" rel="noopener noreferrer">Kuarahy Tech</a>,
        un estudio de software donde encaro proyectos más grandes.
      </p>
      <div class="actions">
        <WhatsappCta size="md" />
        <a href="#proyectos" class="ver-link">ver proyectos</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    background: var(--color-bg);
    color: var(--color-ink);
    padding: clamp(32px, 6vw, 56px) 0 clamp(56px, 9vw, 96px);
  }
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 var(--pad-x);
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: clamp(32px, 8vw, 56px);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .li-link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-cyan);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .li-link:hover {
    color: var(--color-ink);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 24px);
    max-width: 1180px;
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.6vw, 12px);
    letter-spacing: 0.1em;
    color: var(--color-cyan);
    text-transform: uppercase;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-h1);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
    max-width: 15ch;
  }
  .lede {
    margin: 0;
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 50ch;
  }
  .kuarahy-mention {
    margin: 4px 0 0;
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--color-ink-faint);
    max-width: 52ch;
  }
  .kuarahy-mention a {
    color: var(--color-accent);
    font-weight: 600;
  }
  .kuarahy-mention a:hover {
    color: var(--color-cyan);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: clamp(16px, 4vw, 20px);
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .ver-link {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--color-ink-faint);
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: 2px;
  }
  .ver-link:hover {
    color: var(--color-ink);
  }
</style>
