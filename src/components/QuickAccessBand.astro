---
const accesos = [
  { label: 'Proyectos', desc: 'Trabajos reales, con resultado', href: '/proyectos' },
  { label: 'Servicios', desc: 'Qué hago y cómo cobro', href: '/servicios' },
  { label: 'Novedades', desc: 'Lo último, sin filtrar', href: '/novedades' },
  { label: 'Proceso', desc: 'Cómo trabajamos juntos', href: '/proceso' },
];
---

<section class="quick-access">
    <div class="wrap">
        <ul class="grid">
        {accesos.map((a) => (
            <li>
            <a href={a.href} class="card">
                <span class="label">{a.label}</span>
                <span class="desc">{a.desc}</span>
                <span class="arrow" aria-hidden="true">→</span>
            </a>
            </li>
        ))}
        </ul>
    </div>
</section>


<style>
    .quick-access {
        background: var(--color-bg);
        padding: clamp(24px, 4vw, 40px) 0;
    }
    .wrap {
        max-width: var(--wrap);
        margin: 0 auto;
        padding: 0 var(--pad-x);
    }

    .grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .card {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 18px 20px;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        background: var(--color-card);
        color: var(--color-ink);
        transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .card:hover {
        border-color: var(--color-cyan);
        transform: translateY(-2px);
    }
    .card:hover .arrow {
        transform: translateX(3px);
    }

    .label {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 17px;
        color: var(--color-ink);
    }
    .desc {
        font-size: 13.5px;
        line-height: 1.4;
        color: var(--color-ink-soft);
    }
    .arrow {
        margin-top: 4px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--color-link);
        transition: transform 0.15s ease;
    }

    @media (max-width: 720px) {
        .grid {
        grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 440px) {
        .grid {
        grid-template-columns: 1fr;
        }
    }
</style>