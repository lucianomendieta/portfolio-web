---
// Fuentes self-hosted vía Fontsource (nada de CDN de Google Fonts).
// Space Grotesk: 500, 600 (display) · Inter: 400, 500, 600 (cuerpo) · IBM Plex Mono: 500 (detalles).
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/ibm-plex-mono/500.css';

import '../styles/global.css';
import { SITE, LINKEDIN_URL, KUARAHY_URL } from '../config';

interface Props {
  title?: string;
  description?: string;
}
const {title = SITE.title, description = SITE.description} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(SITE.ogImage, Astro.site).href;

// Datos estructurados — ayudan a Google a entender quién sos y qué ofrecés.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Luciano Mendieta',
  jobTitle: 'Desarrollador web',
  description: description,
  url: canonical,
  sameAs: [LINKEDIN_URL, KUARAHY_URL],
  worksFor: {
    '@type': 'Organization',
    name: 'Kuarahy Tech',
    url: KUARAHY_URL,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Asunción',
    addressCountry: 'PY',
  },
  knowsAbout: ['Desarrollo web', 'Landing pages', 'SEO local', 'Astro'],
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: 'Desarrollo de sitios web para negocios',
    },
  },
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <slot />

    <script>
      // Reveal al scroll: fade + translateY(22px → 0), 600ms.
      // Dispara una sola vez por elemento. Respeta prefers-reduced-motion.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

      if (!reduce && 'IntersectionObserver' in window) {
        for (const el of els) el.classList.add('reveal-init');

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );

        for (const el of els) io.observe(el);
      }
    </script>

    <style is:global>
      /* Estado inicial oculto sólo si JS activó el reveal (evita FOUC/sin-JS). */
      [data-reveal].reveal-init {
        opacity: 0;
        transform: translateY(22px);
        transition:
          opacity 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
          transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      [data-reveal].reveal-in {
        opacity: 1;
        transform: none;
      }
    </style>
  </body>
</html>
